@*Created by Cody Watkins*@
@model List<Message>
@{
    ViewData["Title"] = "Messages";
}

<h1>Messages</h1>
<a href="ForumPost">Send a Message</a>

<h2>Your Messages</h2>
@if (Model == null || Model.Count == 0)
{
    <p class="text-center">No messages yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>To: </th>
                <th>From: </th>
                <th>Message: </th>
                <th>Date: </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var message in Model)
            {
                <tr>
                    <td>@message.To?.Name</td>
                    <td>@message.From?.Name</td>
                    <td>@(message.Text ?? "")</td>
                    <td>@message.Date.ToString("d")</td>
                </tr>
            }
        </tbody>
    </table>
}
