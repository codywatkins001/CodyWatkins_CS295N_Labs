@model Message

<div class="text-center">
    <h1>Send a Message</h1>
</div>
<form asp-action="ForumPost" method="Post">
    <div class="mb-3">
        <label class="form-label">To: </label>
        <input asp-for="To.Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">From</label>
        <input asp-for="From.Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Message</label>
        <textarea asp-for="Text" class="form-control" rows="5"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Send Message</button>
</form>
<div class="mt-3">
    <a asp-action="Message">Back to Messages</a>
</div>