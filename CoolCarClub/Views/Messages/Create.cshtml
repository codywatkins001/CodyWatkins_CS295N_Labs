@*Created by Cody Watkins*@
@model Message
@{
    ViewData["Title"] = "Messages";
}


<h2>Send Message</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Sender" class="form-label"></label>
        <input asp-for="Sender" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Recipient" class="form-label"></label>
        <input asp-for="Recipient" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Priority" class="form-label"></label>
        <input asp-for="Priority" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label"></label>
        <textarea asp-for="Body" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Send</button>
</form>

