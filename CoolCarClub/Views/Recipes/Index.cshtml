@model List<RecipeManager.Models.Recipe>

@{
    ViewData["Title"] = "Recipes";
}

<h1>Recipes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Recipe</a>
    <a asp-action="Calculator" class="btn btn-secondary">Serving Calculator</a>
</p>

<form method="get" asp-action="Index">
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Search by Name</label>
            <input type="text" name="searchString" class="form-control" value="@Context.Request.Query["searchString"]" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Category</label>
            <select name="categoryId" class="form-control" asp-items="ViewBag.Categories">
                <option value="">All Categories</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <input type="submit" value="Search" class="btn btn-success" />
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <p>No recipes found.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Prep Time</th>
                <th>Cook Time</th>
                <th>Servings</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recipe in Model)
            {
                <tr>
                    <td>@recipe.Name</td>
                    <td>@recipe.Category?.Name</td>
                    <td>@recipe.PrepTimeMinutes</td>
                    <td>@recipe.CookTimeMinutes</td>
                    <td>@recipe.Servings</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@recipe.RecipeId">Details</a> |
                        <a asp-action="Edit" asp-route-id="@recipe.RecipeId">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@recipe.RecipeId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}